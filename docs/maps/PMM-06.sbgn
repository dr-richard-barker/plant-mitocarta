AL_POOL"><start x="489.8" y="466.2" /><end x="816.0" y="170.1" /></arc><arc id="arc_10" class="production" source="PAP_STROMAL_POOL" target="PAPST1_TRANSLOCATOR"><start x="816.0" y="170.1" /><end x="816.0" y="266.2" /></arc><arc id="arc_11" class="inhibition" source="PAPST1_TRANSLOCATOR" target="XRN2_3_EXORIBONUCLEASES"><start x="816.0" y="266.2" /><end x="1137.7" y="274.0" /></arc><arc id="arc_12" class="stimulation" source="XRN2_3_EXORIBONUCLEASES" target="DROUGHT_STRESS_INDUCED"><start x="1137.7" y="274.0" /><end x="1459.6" y="274.0" /></arc></map></sbgn>